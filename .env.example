# ---------------------------------------------------------------------------
# Email delivery for the quote form (app/api/quote/route.ts)
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# SMTP server settings.
# For the business Outlook inbox, use Outlook's SMTP server:
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=cleanhousecollective@outlook.com
# Generate an "app password" in the Microsoft account security settings
# (Security > Advanced security options > App passwords). Requires 2-step
# verification to be turned on. Do NOT use your normal account password.
SMTP_PASS=your-app-password-here

# Where quote requests are delivered, and the From address.
# For Outlook, QUOTE_FROM should match SMTP_USER (Outlook won't let you send
# "from" an address you don't own).
QUOTE_TO=cleanhousecollective@outlook.com
QUOTE_FROM=cleanhousecollective@outlook.com
