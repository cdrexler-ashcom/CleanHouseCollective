# ---------------------------------------------------------------------------
# Email delivery for the quote form (app/api/quote/route.ts) — powered by Resend
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# 1) Sign up at https://resend.com and create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) The "from" address quotes are sent from.
#    - For real use, add & verify your domain in Resend, then use an address on
#      it, e.g. "Clean House Collective <quotes@cleanhousecollective.com.au>".
#    - For quick testing (no domain needed) you can use Resend's shared sender:
#      QUOTE_FROM="Clean House Collective <onboarding@resend.dev>"
QUOTE_FROM="Clean House Collective <quotes@cleanhousecollective.com.au>"

# 3) Where quote requests are delivered (the business inbox).
QUOTE_TO=cleanhousecollective@outlook.com

# Notes:
#  - The customer automatically receives a confirmation email that includes the
#    $30 deposit direct-deposit details (configured in data/site.ts → booking).
#  - While testing with onboarding@resend.dev, Resend only delivers to the email
#    address you signed up with. Verify a domain to email real customers.
